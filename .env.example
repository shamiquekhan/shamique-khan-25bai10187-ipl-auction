# HTTP + WebSocket port
PORT=3000
# Auctioneer (admin) login password — REQUIRED in production
ADMIN_PASSWORD=change-me
# SQLite database file
DB_PATH=./auction.db
# Seed teams/players automatically if the DB is empty (Render: true)
SEED_ON_EMPTY=false
# Where the seeder writes team passcodes (gitignored)
PASSCODES_CSV=./passcodes.csv
